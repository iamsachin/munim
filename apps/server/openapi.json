              "application/json": { "schema": { "$ref": "#/components/schemas/LockSettings" } }
            }
          }
        },
        "tags": ["account"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LockSettings" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/security": {
      "get": {
        "operationId": "account_api_security",
        "summary": "Security",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SecurityOut" } }
            }
          }
        },
        "tags": ["account"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/delete-all": {
      "post": {
        "operationId": "account_api_delete_all",
        "summary": "Delete All",
        "parameters": [],
        "responses": {
          "204": { "description": "No Content" },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Wait" } } }
          }
        },
        "description": "Removes everything the owner put into Munim, after the passphrase. The account stays.",
        "tags": ["account"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PassphraseIn" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/feeds": {
      "get": {
        "operationId": "reader_api_list_feeds",
        "summary": "List Feeds",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/FeedOut" },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      },
      "post": {
        "operationId": "reader_api_add_feed",
        "summary": "Add Feed",
        "parameters": [],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/FeedOut" } }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Fetches the feed first; it is only added if it can be read. The worker keeps it fresh.",
        "tags": ["reader"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/FeedIn" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/feeds/{feed_id}": {
      "delete": {
        "operationId": "reader_api_remove_feed",
        "summary": "Remove Feed",
        "parameters": [
          {
            "in": "path",
            "name": "feed_id",
            "schema": { "title": "Feed Id", "type": "integer" },
            "required": true
          }
        ],
        "responses": { "204": { "description": "No Content" } },
        "description": "Stops following a feed. Articles the owner saved, queued or highlighted stay, under the\nfeed's name; the rest go with it.",
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/items": {
      "get": {
        "operationId": "reader_api_list_items",
        "summary": "List Items",
        "parameters": [
          {
            "in": "query",
            "name": "show",
            "schema": {
              "default": "all",
              "enum": ["all", "unread", "saved", "later"],
              "title": "Show",
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "anyOf": [
                { "enum": ["RD", "X", "IG", "HN", "YT", "RSS"], "type": "string" },
                { "type": "null" }
              ],
              "title": "Source"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "feed",
            "schema": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Feed" },
            "required": false
          },
          {
            "in": "query",
            "name": "q",
            "schema": { "default": "", "title": "Q", "type": "string" },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/ItemOut" },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Items, newest first. Saved and queued lists are ordered by when that was done.",
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/items/{item_id}": {
      "get": {
        "operationId": "reader_api_get_item",
        "summary": "Get Item",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "schema": { "title": "Item Id", "type": "integer" },
            "required": true
          },
          {
            "in": "query",
            "name": "q",
            "schema": { "default": "", "title": "Q", "type": "string" },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ItemDetail" } }
            }
          }
        },
        "description": "One item. With `q`, the search it was opened from, it also says which of its words\nmatched, so they can be marked where they are.",
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      },
      "patch": {
        "operationId": "reader_api_change_item",
        "summary": "Change Item",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "schema": { "title": "Item Id", "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ItemOut" } }
            }
          }
        },
        "description": "Marks an item read or unread, saved or not, queued for later or not.",
        "tags": ["reader"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ItemPatch" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/highlights": {
      "get": {
        "operationId": "reader_api_list_highlights",
        "summary": "List Highlights",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/HighlightOut" },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Every highlight, newest first.",
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/items/{item_id}/highlights": {
      "post": {
        "operationId": "reader_api_add_highlight",
        "summary": "Add Highlight",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "schema": { "title": "Item Id", "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HighlightOut" } }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Marks a passage. Marking the same place twice gives back the first highlight.",
        "tags": ["reader"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/HighlightIn" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/highlights/{highlight_id}": {
      "patch": {
        "operationId": "reader_api_change_highlight",
        "summary": "Change Highlight",
        "parameters": [
          {
            "in": "path",
            "name": "highlight_id",
            "schema": { "title": "Highlight Id", "type": "integer" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HighlightOut" } }
            }
          }
        },
        "description": "Sets the note. An empty note removes it.",
        "tags": ["reader"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NoteIn" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      },
      "delete": {
        "operationId": "reader_api_remove_highlight",
        "summary": "Remove Highlight",
        "parameters": [
          {
            "in": "path",
            "name": "highlight_id",
            "schema": { "title": "Highlight Id", "type": "integer" },
            "required": true
          }
        ],
        "responses": { "204": { "description": "No Content" } },
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/sources/hacker-news": {
      "get": {
        "operationId": "reader_api_hacker_news",
        "summary": "Hacker News",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionOut" } }
            }
          }
        },
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      },
      "put": {
        "operationId": "reader_api_set_hacker_news",
        "summary": "Set Hacker News",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionOut" } }
            }
          }
        },
        "description": "Switches Hacker News on or off. Off stops the fetching; what was fetched stays.",
        "tags": ["reader"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ConnectionIn" } }
          },
          "required": true
        },
        "security": [{ "Open": [] }]
      }
    },
    "/api/counts": {
      "get": {
        "operationId": "reader_api_counts",
        "summary": "Counts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Counts" } }
            }
          }
        },
        "description": "The numbers beside the sidebar's rows.",
        "tags": ["reader"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/ai/keys": {
      "get": {
        "operationId": "ai_api_list_keys",
        "summary": "List Keys",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": { "$ref": "#/components/schemas/KeyOut" },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "tags": ["ai"],
        "security": [{ "Open": [] }]
      }
    },
    "/api/ai/keys/{provider}": {
      "put": {
        "operationId": "ai_api_set_key",
        "summary": "Set Key",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "schema": { "enum": ["openai", "anthropic"], "title": "Provider", "type": "string" },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/KeyOut" } }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        },
        "description": "Stores a key, sealed, after asking the provider whether it accepts it. A key the provider\nrejects is stored too, marked as rejected, so the owner sees which key that was.",
        "tags": ["ai"],
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/KeyIn" } } },
          "required": true
        },
        "security": [{ "Open": [] }]
      },
      "delete": {
        "operationId": "ai_api_remove_key",
        "summary": "Remove Key",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "schema": { "enum": ["openai", "anthropic"], "title": "Provider", "type": "string" },
            "required": true
          }
        ],
        "responses": { "204": { "description": "No Content" } },
        "tags": ["ai"],
        "security": [{ "Open": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": { "enum": ["ok", "unavailable"], "title": "Status", "type": "string" }
        },
        "required": ["status"],
        "title": "Health",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "state": {
            "enum": ["setup", "signed_out", "locked", "open"],
            "title": "State",
            "type": "string"
          }
        },
        "required": ["state"],
        "title": "SessionOut",
        "type": "object"
      },
      "Error": {
        "properties": { "detail": { "title": "Detail", "type": "string" } },
        "required": ["detail"],
        "title": "Error",
        "type": "object"
      },
      "PassphraseIn": {
        "properties": {
          "passphrase": { "maxLength": 1024, "title": "Passphrase", "type": "string" }
        },
        "required": ["passphrase"],
        "title": "PassphraseIn",
        "type": "object"
      },
      "Wait": {
        "properties": {
          "detail": { "title": "Detail", "type": "string" },
          "wait_seconds": { "title": "Wait Seconds", "type": "integer" }
        },
        "required": ["detail", "wait_seconds"],
        "title": "Wait",
        "type": "object"
      },
      "ChangeIn": {
        "properties": {
          "current": { "maxLength": 1024, "title": "Current", "type": "string" },
          "new": { "maxLength": 1024, "title": "New", "type": "string" }
        },
        "required": ["current", "new"],
        "title": "ChangeIn",
        "type": "object"
      },
      "DeviceOut": {
        "properties": {
          "id": { "title": "Id", "type": "integer" },
          "name": { "title": "Name", "type": "string" },
          "last_seen": { "format": "date-time", "title": "Last Seen", "type": "string" },
          "current": { "title": "Current", "type": "boolean" }
        },
        "required": ["id", "name", "last_seen", "current"],
        "title": "DeviceOut",
        "type": "object"
      },
      "LockSettings": {
