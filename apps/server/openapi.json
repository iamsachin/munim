          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Wait" } } }
          }
        },
        "tags": ["account"],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PassphraseIn" } }
          },
          "required": true
        },
        "security": [{ "Csrf": [] }]
      }
    },
    "/api/sign-out": {
      "post": {
        "operationId": "account_api_sign_out",
        "summary": "Sign Out",
        "parameters": [],
        "responses": { "204": { "description": "No Content" } },
        "tags": ["account"],
        "security": [{ "SignedIn": [] }]
      }
    },
    "/api/lock": {
      "post": {
        "operationId": "account_api_lock",
        "summary": "Lock",
        "parameters": [],
        "responses": { "204": { "description": "No Content" } },
        "tags": ["account"],
        "security": [{ "SignedIn": [] }]
      }
    },
    "/api/unlock": {
      "post": {
        "operationId": "account_api_unlock",
