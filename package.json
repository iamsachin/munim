{
  "name": "munim",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm -r lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"*.{js,json,yaml}\" && pnpm -r format",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"*.{js,json,yaml}\"",
    "test": "pnpm -r test",
    "e2e": "pnpm -r e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm api:check && pnpm test && pnpm e2e",
    "dev:server": "pnpm --filter server dev",
    "db": "docker compose -f compose.dev.yaml up -d --wait db",
    "gen:api": "pnpm --filter web gen:api",
    "api:check": "pnpm gen:api && git diff --exit-code -- apps/server/openapi.json apps/web/src/api/schema.d.ts",
    "dev:web": "pnpm --filter web dev",
    "test-stack:server": "./apps/server/e2e_server.sh",
    "test-stack:worker": "cd apps/server && MUNIM_DEBUG=1 MUNIM_DB_NAME=munim_e2e uv run python manage.py procrastinate worker",
    "test-stack:web": "MUNIM_SERVER=http://127.0.0.1:8001 pnpm --filter web exec vite --port 4173 --strictPort"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
